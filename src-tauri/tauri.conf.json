{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "圣手码头",
  "mainBinaryName": "ShengShouMaTou",
  "version": "0.7.0",
  "identifier": "com.cherish.shengshoumatou",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "圣手码头",
        "width": 1080,
        "height": 720,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2QTdGNUY4QTdCNzI4OUQKUldTZEtMZW4rUFduRnVBVGVaNnlaTlVIditRcDhVY2JKSVg3dG03K1RvK0hmS0tTamlWcFpQZUoK",
      "endpoints": [
        "https://gitee.com/princess-zp/shengShouMaTou/releases/download/latest/latest.json",
        "https://github.com/cherish-zp/shengShouMaTou/releases/latest/download/latest.json"
      ]
    },
    "process": {}
  }
